{
  "manifest_version": 3,
  "name": "MoxyVPN",
  "version": "1.0.0",
  "description": "Send Chrome through your MoxyVPN proxy. One-click connect, data usage, and per-site control.",
  "icons": {
    "16": "icons/moxy-16.png",
    "32": "icons/moxy-32.png",
    "48": "icons/moxy-48.png",
    "128": "icons/moxy-128.png"
  },
  "action": {
    "default_title": "MoxyVPN",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/gray-16.png",
      "32": "icons/gray-32.png",
      "48": "icons/gray-48.png",
      "128": "icons/gray-128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["proxy", "storage", "privacy", "alarms", "activeTab"],
  "host_permissions": [
    "http://127.0.0.1:47832/*",
    "https://www.cloudflare.com/*"
  ]
}
